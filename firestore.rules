rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function institutional() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@uteq\\.edu\\.mx$');
    }

    function admin() {
      return signedIn()
        && request.auth.token.email == 'ivan.gutierrez@uteq.edu.mx';
    }

    function own(uid) {
      return institutional() && request.auth.uid == uid;
    }

    function sessionPath(uid) {
      return /databases/$(database)/documents/profileSessions/$(uid);
    }

    function sessionExists(uid) {
      return exists(sessionPath(uid));
    }

    function validSessionCreate(uid) {
      return sessionExists(uid)
        && request.resource.data.writerSessionId is string
        && request.resource.data.writerSessionId == get(sessionPath(uid)).data.activeSessionId
        && request.resource.data.sessionWriteSeq is int;
    }

    function validSessionUpdate(uid) {
      return sessionExists(uid)
        && request.resource.data.writerSessionId is string
        && request.resource.data.writerSessionId == get(sessionPath(uid)).data.activeSessionId
        && request.resource.data.sessionWriteSeq is int
        && (
          !resource.data.keys().hasAll(['sessionWriteSeq'])
          || request.resource.data.sessionWriteSeq > resource.data.sessionWriteSeq
        );
    }

    function adminOnlyFields() {
      return [
        'individualEditDisabled',
        'profileResetToken',
        'profileDeletionToken',
        'deletedByAdmin',
        'deletedAt',
        'deletedBy',
        'programProfileResetAt',
        'programProfileResetBy',
        'reopenedAt',
        'reopenedBy',
        'individualEditUpdatedAt'
      ];
    }

    function ownerDoesNotChangeAdminFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminOnlyFields());
    }

    function ownerMayCloseOwnReopen() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['individualEditEnabled'])
        || (
          request.resource.data.individualEditEnabled == false
          && request.resource.data.submittedPeriod is string
          && (
            !resource.data.keys().hasAll(['individualEditEnabled'])
            || resource.data.individualEditEnabled == true
          )
        );
    }

    function profileNotIndividuallyBlocked() {
      return !resource.data.keys().hasAll(['individualEditDisabled'])
        || resource.data.individualEditDisabled != true;
    }

    match /settings/{document=**} {
      allow read: if institutional();
      allow write: if admin();
    }

    match /profileSessions/{uid} {
      allow read: if admin() || own(uid);
      allow create, update: if admin() || own(uid);
      allow delete: if admin();
    }

    match /profiles/{uid} {
      allow read: if admin() || own(uid);

      // Creación normal del perfil por el propio profesor.
      // Los controles administrativos no pueden nacer desde el cliente del profesor.
      allow create: if admin()
        || (
          own(uid)
          && (!sessionExists(uid) || validSessionCreate(uid))
          && !request.resource.data.keys().hasAny(adminOnlyFields())
          && !request.resource.data.keys().hasAny(['individualEditEnabled'])
        );

      // El profesor sólo puede escribir si:
      // 1) su sesión es la sesión activa;
      // 2) Administración no bloqueó individualmente su perfil;
      // 3) no intenta cambiar campos reservados a Administración.
      // individualEditEnabled sólo puede pasar de true a false al volver a finalizar.
      allow update: if admin()
        || (
          own(uid)
          && profileNotIndividuallyBlocked()
          && (!sessionExists(uid) || validSessionUpdate(uid))
          && ownerDoesNotChangeAdminFields()
          && ownerMayCloseOwnReopen()
        );

      allow delete: if admin();
    }

    match /audit/{entry} {
      allow read: if admin();
      allow create: if institutional();
      allow update, delete: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function institutional() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@uteq\\.edu\\.mx$');
    }

    function admin() {
      return signedIn()
        && request.auth.token.email == 'ivan.gutierrez@uteq.edu.mx';
    }

    match /settings/{document=**} {
      allow read: if institutional();
      allow write: if admin();
    }

    match /profiles/{uid} {
      allow read: if admin() || (institutional() && request.auth.uid == uid);

      // El profesor administra únicamente su propio perfil.
      // Administración puede reabrir/cerrar de forma individual perfiles ajenos.
      allow create, update: if admin()
        || (institutional() && request.auth.uid == uid);

      allow delete: if admin();
    }

    match /audit/{entry} {
      allow read: if admin();
      allow create: if institutional();
      allow update, delete: if false;
    }
  }
}
